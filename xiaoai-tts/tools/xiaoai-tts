#!/usr/bin/env python3
"""Unified XiaoAI speaker control CLI."""

import argparse
import os
import shutil
import subprocess
import sys


DEFAULT_SCOPE = "feishu-default"

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
BASE_DIR = os.path.dirname(SCRIPT_DIR)
SCRIPTS_DIR = os.path.join(BASE_DIR, "scripts")
sys.path.insert(0, SCRIPTS_DIR)

from cli_utils import (  # noqa: E402
    default_scope,
    max_chars_value,
    nonnegative_pause_value,
    positive_timeout_value,
    speed_value,
)


def configure_stdio() -> None:
    """Keep Windows service logs from failing on Chinese output."""
    for stream_name in ("stdout", "stderr"):
        stream = getattr(sys, stream_name, None)
        if stream is not None and hasattr(stream, "reconfigure"):
            stream.reconfigure(encoding="utf-8", errors="replace")


def python_command():
    """Return a Python command that works across Linux, macOS, and Windows."""
    if sys.executable:
        return [sys.executable]
    for candidate in ("python3", "python"):
        if shutil.which(candidate):
            return [candidate]
    if os.name == "nt" and shutil.which("py"):
        return ["py", "-3"]
    return ["python3"]


def run_script(script_name, args_list, capture=True):
    """Run one implementation script without invoking a shell."""
    script_path = os.path.join(SCRIPTS_DIR, script_name)
    if not os.path.exists(script_path):
        print(f"错误: 脚本不存在 {script_path}", file=sys.stderr)
        return None, "", "脚本不存在", 1

    cmd = python_command() + [script_path] + args_list
    env = os.environ.copy()
    env.setdefault("PYTHONIOENCODING", "utf-8:replace")
    env.setdefault("PYTHONDONTWRITEBYTECODE", "1")

    if capture:
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            env=env,
            check=False,
        )
        return result, result.stdout, result.stderr, result.returncode
    result = subprocess.run(cmd, env=env, check=False)
    return result, "", "", result.returncode


def print_captured(stdout, stderr) -> None:
    if stdout:
        print(stdout, end="")
    if stderr:
        print(stderr, end="", file=sys.stderr)


def add_broadcast_input_args(parser, stateful=False) -> None:
    parser.add_argument(
        "content",
        nargs="?",
        help="要处理的文字内容；长文本建议使用 --file、--stdin 或 --from-env",
    )
    parser.add_argument("--file", "-f", help="从 UTF-8 文本文件读取内容")
    parser.add_argument("--stdin", action="store_true", help="从标准输入读取内容")
    parser.add_argument(
        "--from-env",
        action="store_true",
        help="从 XIAOAI_TTS_MESSAGE 环境变量读取内容",
    )
    if stateful:
        parser.add_argument(
            "--scope",
            default=default_scope(DEFAULT_SCOPE),
            help="状态作用域，建议使用聊天会话 ID",
        )
    parser.add_argument(
        "--max-chars",
        type=max_chars_value,
        default=450,
        help="每段最大字数（默认 450）",
    )
    parser.add_argument(
        "--timeout",
        "-t",
        type=positive_timeout_value,
        default=600000,
        help="每段超时时间（毫秒，默认 600000）",
    )
    parser.add_argument(
        "--pause",
        type=nonnegative_pause_value,
        default=0.4,
        help="分段间隔秒数（默认 0.4）",
    )
    if stateful:
        parser.add_argument(
            "--force", action="store_true", help="忽略模式状态，强制播报"
        )
        parser.add_argument(
            "--dry-run", action="store_true", help="只判断动作，不实际播报"
        )
        parser.add_argument("--json", action="store_true", help="输出 JSON")


def make_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="XiaoAI TTS 控制工具",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
示例:
  xiaoai-tts tts "你好，小爱"           # 优先 Doubao，失败回退小爱 TTS
  xiaoai-tts text "你好"                # 强制使用小爱自带 TTS
  xiaoai-tts broadcast --file story.txt  # 分段顺序播报长文本
  xiaoai-tts mode on --scope feishu      # 开启播报模式
  xiaoai-tts handle --from-env            # 从结构化环境变量处理聊天消息
  xiaoai-tts wakeup                       # 唤醒小爱
  xiaoai-tts interrupt                    # 停止当前播放
  xiaoai-tts status                       # 获取播放状态
  xiaoai-tts health                       # 检查服务健康
        """,
    )
    subparsers = parser.add_subparsers(dest="command", help="可用命令")

    tts_parser = subparsers.add_parser(
        "tts", help="语音播报（优先 Doubao TTS，失败自动回退小爱 TTS）"
    )
    tts_parser.add_argument("content", help="要播放的文字内容")
    tts_parser.add_argument("--speaker", "-s", default="", help="音色名称")
    tts_parser.add_argument(
        "--speed", type=speed_value, default=1.0, help="语速（0.8-2.0，默认 1.0）"
    )
    tts_parser.add_argument("--emotion", "-e", help="情感（仅多情感音色支持）")
    tts_parser.add_argument("--mood", "-m", help="语气/情感别名（同 --emotion）")
    tts_parser.add_argument("--context", "-c", help="上下文指令")
    tts_parser.add_argument("--blocking", "-b", action="store_true", help="阻塞模式")
    tts_parser.add_argument(
        "--timeout",
        "-t",
        type=positive_timeout_value,
        default=60000,
        help="超时时间（毫秒）",
    )

    text_parser = subparsers.add_parser("text", help="使用小爱自带 TTS 播放")
    text_parser.add_argument("content", help="要播放的文字内容")
    text_parser.add_argument(
        "--blocking", "-b", action="store_true", help="阻塞模式（等待播放完成）"
    )
    text_parser.add_argument(
        "--timeout",
        "-t",
        type=positive_timeout_value,
        default=60000,
        help="超时时间（毫秒）",
    )

    broadcast_parser = subparsers.add_parser(
        "broadcast", help="长文本分段顺序播报（小爱自带 TTS）"
    )
    add_broadcast_input_args(broadcast_parser)

    mode_parser = subparsers.add_parser("mode", help="开启、关闭或查看小爱播报模式")
    mode_parser.add_argument("mode", choices=["on", "off", "status"], help="模式操作")
    mode_parser.add_argument(
        "--scope",
        default=default_scope(DEFAULT_SCOPE),
        help="状态作用域，建议使用聊天会话 ID",
    )
    mode_parser.add_argument("--json", action="store_true", help="输出 JSON")

    handle_parser = subparsers.add_parser(
        "handle", help="处理聊天消息：识别启动、退出、转发或忽略"
    )
    add_broadcast_input_args(handle_parser, stateful=True)

    forward_parser = subparsers.add_parser(
        "forward", help="按当前播报模式状态转发正文给小爱"
    )
    add_broadcast_input_args(forward_parser, stateful=True)

    wakeup_parser = subparsers.add_parser("wakeup", help="唤醒小爱音箱")
    wakeup_parser.add_argument("--silent", action="store_true", help="静默唤醒")

    subparsers.add_parser("interrupt", help="停止当前播放")
    subparsers.add_parser("status", help="获取音箱播放状态")
    subparsers.add_parser("health", help="检查服务健康状态")

    file_parser = subparsers.add_parser("file", help="播放本地音频文件")
    file_parser.add_argument("path", help="本地音频文件路径")

    url_parser = subparsers.add_parser("url", help="播放远程音频 URL")
    url_parser.add_argument("url", help="远程音频 URL")

    voices_parser = subparsers.add_parser("voices", help="列出可用音色")
    voices_parser.add_argument(
        "--version", "-v", choices=["1.0", "2.0"], help="仅显示指定版本的音色"
    )
    return parser


def forward_input_args(args):
    cmd_args = []
    if args.content is not None:
        cmd_args.append(args.content)
    if args.file:
        cmd_args.extend(["--file", args.file])
    if args.stdin:
        cmd_args.append("--stdin")
    if args.from_env:
        cmd_args.append("--from-env")
    if args.max_chars != 450:
        cmd_args.extend(["--max-chars", str(args.max_chars)])
    if args.timeout != 600000:
        cmd_args.extend(["--timeout", str(args.timeout)])
    if args.pause != 0.4:
        cmd_args.extend(["--pause", str(args.pause)])
    return cmd_args


def main() -> int:
    configure_stdio()
    parser = make_parser()
    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        return 1

    if args.command == "tts":
        cmd_args = [args.content]
        if args.speaker:
            cmd_args.extend(["--speaker", args.speaker])
        if args.speed != 1.0:
            cmd_args.extend(["--speed", str(args.speed)])
        mood_or_emotion = args.mood or args.emotion
        if mood_or_emotion:
            cmd_args.extend(["--emotion", mood_or_emotion])
        if args.context:
            cmd_args.extend(["--context", args.context])
        if args.blocking:
            cmd_args.append("--blocking")
        if args.timeout != 60000:
            cmd_args.extend(["--timeout", str(args.timeout)])

        result, stdout, stderr, code = run_script("tts_doubao.py", cmd_args)
        if code == 0 and result is not None:
            print(stdout, end="")
            return 0

        print_captured(stdout, stderr)
        print("WARN: Doubao TTS 失败，回退到小爱自带 TTS...", file=sys.stderr)
        text_args = [args.content]
        if args.blocking:
            text_args.append("--blocking")
        if args.timeout != 60000:
            text_args.extend(["--timeout", str(args.timeout)])
        return run_script("play_text.py", text_args, capture=False)[3]

    if args.command == "text":
        cmd_args = [args.content]
        if args.blocking:
            cmd_args.append("--blocking")
        if args.timeout != 60000:
            cmd_args.extend(["--timeout", str(args.timeout)])
        return run_script("play_text.py", cmd_args, capture=False)[3]

    if args.command == "broadcast":
        return run_script("broadcast_text.py", forward_input_args(args), capture=False)[
            3
        ]

    if args.command == "mode":
        cmd_args = ["mode", args.mode, "--scope", args.scope]
        if args.json:
            cmd_args.append("--json")
        return run_script("broadcast_mode.py", cmd_args, capture=False)[3]

    if args.command in ("handle", "forward"):
        cmd_args = [args.command] + forward_input_args(args)
        cmd_args.extend(["--scope", args.scope])
        if args.force:
            cmd_args.append("--force")
        if args.dry_run:
            cmd_args.append("--dry-run")
        if args.json:
            cmd_args.append("--json")
        return run_script("broadcast_mode.py", cmd_args, capture=False)[3]

    if args.command == "wakeup":
        cmd_args = ["wakeup"]
        if args.silent:
            cmd_args.append("--silent")
        return run_script("control.py", cmd_args, capture=False)[3]

    if args.command in ("interrupt", "status", "health"):
        return run_script("control.py", [args.command], capture=False)[3]

    if args.command == "file":
        return run_script("play_file.py", [args.path], capture=False)[3]

    if args.command == "url":
        return run_script("play_url.py", [args.url], capture=False)[3]

    if args.command == "voices":
        cmd_args = []
        if args.version:
            cmd_args.extend(["--version", args.version])
        return run_script("list_doubao_voices.py", cmd_args, capture=False)[3]

    parser.error(f"unsupported command: {args.command}")
    return 2


if __name__ == "__main__":
    sys.exit(main())
